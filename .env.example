# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 绘画 API (豆包 Seedream / 火山引擎方舟)
PAINTING_API_KEY=your-painting-api-key
PAINTING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PAINTING_MODEL=doubao-seedream-4-5-251128

# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_gf
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural

# App
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
